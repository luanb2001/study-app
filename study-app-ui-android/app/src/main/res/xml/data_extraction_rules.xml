<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="study_app_account_session.xml" />
        <exclude domain="sharedpref" path="study_app_installation.xml" />
        <exclude domain="sharedpref" path="study_app_trial.xml" />
        <exclude domain="sharedpref" path="pomodoro_session.xml" />
        <exclude domain="database" path="study_app.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="study_app_account_session.xml" />
        <exclude domain="sharedpref" path="study_app_installation.xml" />
        <exclude domain="sharedpref" path="study_app_trial.xml" />
        <exclude domain="sharedpref" path="pomodoro_session.xml" />
        <exclude domain="database" path="study_app.db" />
    </device-transfer>
</data-extraction-rules>
